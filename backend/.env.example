# Database — SQLite (default, zero-config):
DATABASE_URL="file:./dev.db"

# Database — PostgreSQL (uncomment and fill in to use Postgres instead):
# DATABASE_URL="postgresql://user:password@localhost:5432/healthconnect?schema=public"

# JWT secret — change this in production
JWT_SECRET="healthconnect-demo-secret-change-me"

# Server port
PORT=3001
